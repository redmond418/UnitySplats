#define GROUP_SIZE 256

#pragma kernel InitOrder
#pragma kernel InitActiveRanges

#pragma multi_compile __ UPDATE_BOUNDS

uint _SplatCount;
uint _ActiveSplatCount;
uint _ActiveRangeCount;

AppendStructuredBuffer<uint> _OrderBuffer;
RWStructuredBuffer<uint> _ActiveOrderBuffer;
StructuredBuffer<uint4> _ActiveRanges;
StructuredBuffer<float4> _PositionBuffer;

struct GaussianCutoutShaderData
{
    float4x4 mat;
    uint typeAndFlags;
    uint padding0;
    uint padding1;
    uint padding2;
};

uint _CutoutsCount;
StructuredBuffer<GaussianCutoutShaderData> _CutoutsBuffer;

#ifdef UPDATE_BOUNDS
RWStructuredBuffer<uint> _BoundsBuffer;
#endif

#include "GsplatCutout.hlsl"

[numthreads(GROUP_SIZE,1,1)]
void InitOrder(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    float3 splatPos = _PositionBuffer[idx].xyz;

    if (!IsSplatCut(splatPos))
    {
        _OrderBuffer.Append(idx);

#ifdef UPDATE_BOUNDS
        InterlockedMin(_BoundsBuffer[0], FloatToSortableUint(splatPos.x));
        InterlockedMin(_BoundsBuffer[1], FloatToSortableUint(splatPos.y));
        InterlockedMin(_BoundsBuffer[2], FloatToSortableUint(splatPos.z));
        InterlockedMax(_BoundsBuffer[3], FloatToSortableUint(splatPos.x));
        InterlockedMax(_BoundsBuffer[4], FloatToSortableUint(splatPos.y));
        InterlockedMax(_BoundsBuffer[5], FloatToSortableUint(splatPos.z));
#endif
    }
}

[numthreads(GROUP_SIZE,1,1)]
void InitActiveRanges(uint3 id : SV_DispatchThreadID)
{
    uint selectionIndex = id.x;
    if (selectionIndex >= _ActiveSplatCount)
        return;

    if (_ActiveRangeCount == 1)
    {
        _ActiveOrderBuffer[selectionIndex] = _ActiveRanges[0].x + selectionIndex;
        return;
    }

    uint lo = 0;
    uint hi = _ActiveRangeCount;
    while (lo < hi)
    {
        uint mid = lo + ((hi - lo) >> 1u);
        if (selectionIndex < _ActiveRanges[mid].z)
            hi = mid;
        else
            lo = mid + 1u;
    }

    uint4 range = _ActiveRanges[lo];
    uint prefixStart = range.z - range.y;
    _ActiveOrderBuffer[selectionIndex] = range.x + selectionIndex - prefixStart;
}
