#define GROUP_SIZE 256

#pragma kernel CalcDepth

#define GSPLAT_SKINNING_POSITION_ONLY
#include "GsplatSkinning.hlsl"

uint _SplatCount;
float4x4 _MatrixMV;
StructuredBuffer<float4> _PositionBuffer;
StructuredBuffer<uint> _OrderBuffer;
RWStructuredBuffer<float> _DepthBuffer;

[numthreads(GROUP_SIZE,1,1)]
void CalcDepth(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    uint sourceId = _OrderBuffer[idx];
    float3 pos = _PositionBuffer[sourceId].xyz;
    GsplatApplySkinningPosition(sourceId, pos);
    pos = mul(_MatrixMV, float4(pos.xyz, 1)).xyz;
    _DepthBuffer[idx] = pos.z;
}
